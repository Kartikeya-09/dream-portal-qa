{
  "name": "dream-portal-qa",
  "version": "1.0.0",
  "description": "Automated functional test suite for the Dream Portal website (QA Intern Assignment)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:home": "playwright test tests/home.spec.ts",
    "test:diary": "playwright test tests/diary.spec.ts",
    "test:total": "playwright test tests/total.spec.ts",
    "test:ai": "playwright test tests/ai-validation.spec.ts",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^2.15.1",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "openai": "^4.60.0"
  }
}
